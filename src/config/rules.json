{
  "designSystem": {
    "philosophy": "Strict Binary Black & White",
    "colorTokens": {
      "dark": {
        "bgCore": "#000000",
        "bgSurface": "#000000",
        "textPrimary": "#ffffff",
        "textSecondary": "#ffffff",
        "textTertiary": "#ffffff",
        "glassFill": "transparent",
        "glassFillHover": "transparent",
        "glassBorder": "#ffffff",
        "glassSpecular": "transparent",
        "glassShadow": "none"
      },
      "light": {
        "bgCore": "#ffffff",
        "bgSurface": "#ffffff",
        "textPrimary": "#000000",
        "textSecondary": "#000000",
        "textTertiary": "#000000",
        "glassFill": "transparent",
        "glassFillHover": "transparent",
        "glassBorder": "#000000",
        "glassSpecular": "transparent",
        "glassShadow": "none"
      }
    },
    "geometry": {
      "radiusCapsule": "9999px",
      "radiusCell": "16px",
      "radiusCard": "28px"
    },
    "optical": {
      "blur": "0px",
      "saturate": "100%",
      "transitionFast": "0ms",
      "transitionSmooth": "0ms"
    }
  },
  "constraints": {
    "viewport": {
      "overflowX": "hidden",
      "maxModalHeight": "86dvh",
      "modalAlignment": "center"
    },
    "forbiddenColors": [
      "gray", "grey", "silver", "slate",
      "#0c0c0c", "#f4f4f4", "#888888", "#1c1c1e", "#787880",
      "green", "red", "blue", "yellow", "purple", "orange"
    ]
  }
}