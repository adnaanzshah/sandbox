{
  "designSystem": {
    "philosophy": "Strict Monochrome Liquid Glass",
    "colorTokens": {
      "dark": {
        "bgCore": "#000000",
        "bgSurface": "#0c0c0c",
        "textPrimary": "#ffffff",
        "textSecondary": "rgba(255, 255, 255, 0.60)",
        "textTertiary": "rgba(255, 255, 255, 0.35)",
        "glassFill": "rgba(255, 255, 255, 0.06)",
        "glassFillHover": "rgba(255, 255, 255, 0.10)",
        "glassBorder": "rgba(255, 255, 255, 0.12)",
        "glassSpecular": "rgba(255, 255, 255, 0.18)",
        "glassShadow": "0 20px 50px rgba(0, 0, 0, 0.80)"
      },
      "light": {
        "bgCore": "#ffffff",
        "bgSurface": "#f4f4f4",
        "textPrimary": "#000000",
        "textSecondary": "rgba(0, 0, 0, 0.60)",
        "textTertiary": "rgba(0, 0, 0, 0.35)",
        "glassFill": "rgba(0, 0, 0, 0.04)",
        "glassFillHover": "rgba(0, 0, 0, 0.07)",
        "glassBorder": "rgba(0, 0, 0, 0.10)",
        "glassSpecular": "rgba(255, 255, 255, 0.90)",
        "glassShadow": "0 14px 40px rgba(0, 0, 0, 0.08)"
      }
    },
    "geometry": {
      "radiusCapsule": "9999px",
      "radiusCell": "16px",
      "radiusCard": "28px"
    },
    "optical": {
      "blur": "40px",
      "saturate": "180%",
      "transitionFast": "180ms cubic-bezier(0.16, 1, 0.3, 1)",
      "transitionSmooth": "350ms cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },
  "constraints": {
    "viewport": {
      "overflowX": "hidden",
      "maxModalHeight": "86dvh",
      "modalAlignment": "center"
    },
    "forbiddenColors": [
      "green", "red", "blue", "yellow", "purple", "orange",
      "#34c759", "#ff3b30", "#007aff", "#5856d6", "#ff9500"
    ]
  }
}